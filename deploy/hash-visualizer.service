[Unit]
Description=Hash Algorithm Visualizer Web Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Work/www/hash
ExecStart=/home/ubuntu/Work/www/hash/deploy/start.sh
Restart=always
RestartSec=5
Environment=PORT=3002
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
